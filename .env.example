# Copie para .env (que NÃO vai para o Git) e preencha.
# Nunca commite senhas de banco. Em DEV/QA/PRD essas variáveis ficam na Vercel.

APP_ENV=LOCAL
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Opção 1: Postgres local (npm run db:up) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projeto
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/projeto

# --- Opção 2: Supabase (Project Settings > Database > Connection string) ---
# Aplicação -> Transaction pooler (porta 6543)
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?schema=dev   (QA: ?schema=qa | PRD: ?schema=prd)
# Migrações -> Session pooler (porta 5432)
# DIRECT_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=dev
