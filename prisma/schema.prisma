// Modelo inicial do banco — PONTO DE PARTIDA.
// Ajuste para refletir o DER aprovado pelo time de Modelagem.
//
// Integridade (RNF11):
//  - Toda relação é uma foreign key de verdade no PostgreSQL.
//  - onDelete: Restrict impede apagar um curso/professor/sala que ainda está em uso.
//  - @@unique impede duplicidades (ex.: duas turmas na mesma sala, mesmo dia e horário).
//
// Depois de alterar este arquivo:  npm run db:migrate -- --name descricao_da_mudanca

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Mapa (D1) ----------

model Sala {
  id              Int      @id @default(autoincrement()) @map("id_sala")
  nome            String   @db.VarChar(120)
  codigo          String   @unique @db.VarChar(20) // ex.: "BL4-104"
  bloco           String   @db.VarChar(20)
  andar           Int
  tipo            String   @db.VarChar(30) // ex.: "SALA_DE_AULA", "LABORATORIO"
  localizacaoMapa String   @map("localizacao_mapa") @db.VarChar(255)
  imagens         Imagem[]
  aulas           Aula[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("salas")
}

model Imagem {
  id        Int    @id @default(autoincrement()) @map("id_imagem")
  salaId    Int    @map("id_sala")
  url       String @map("url_imagem") @db.VarChar(500)
  // Fora do DER: o contrato (2.4) e o RNF10 exigem texto alternativo. Levar para a Modelagem.
  descricao String @db.VarChar(255)
  sala      Sala   @relation(fields: [salaId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([salaId])
  @@map("imagens")
}

// ---------- Acadêmico (D2) ----------

model Curso {
  id    Int    @id @default(autoincrement()) @map("id_curso")
  nome  String @db.VarChar(120)
  sigla String @unique @db.VarChar(20) // ex.: "SI" — usada no filtro ?curso=
  aulas Aula[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("cursos")
}

model Disciplina {
  id    Int    @id @default(autoincrement()) @map("id_disciplina")
  nome  String @db.VarChar(120)
  aulas Aula[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("disciplinas")
}

model Professor {
  id    Int    @id @default(autoincrement()) @map("id_professor")
  nome  String @db.VarChar(120)
  aulas Aula[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("professores")
}

model Turma {
  id       Int    @id @default(autoincrement()) @map("id_turma")
  nome     String @db.VarChar(60) // está no UML; o DER lógico só tem semestre
  semestre Int // ex.: 3 (3º semestre)
  aulas    Aula[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("turmas")
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA

  @@map("dia_semana")
}

enum Periodo {
  MATUTINO
  VESPERTINO
  NOTURNO

  @@map("periodo")
}

model Aula {
  id           Int       @id @default(autoincrement()) @map("id_aula")
  salaId       Int       @map("id_sala")
  cursoId      Int       @map("id_curso")
  disciplinaId Int       @map("id_disciplina")
  professorId  Int       @map("id_professor")
  turmaId      Int       @map("id_turma")
  diaSemana    DiaSemana @map("dia_semana")
  periodo      Periodo
  horaInicio   DateTime  @map("hora_inicio") @db.Time(0)
  horaTermino  DateTime  @map("hora_termino") @db.Time(0)

  sala       Sala       @relation(fields: [salaId], references: [id], onDelete: Restrict)
  curso      Curso      @relation(fields: [cursoId], references: [id], onDelete: Restrict)
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  professor  Professor  @relation(fields: [professorId], references: [id], onDelete: Restrict)
  turma      Turma      @relation(fields: [turmaId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Mesma sala ou mesma turma não começam duas aulas no mesmo dia e horário.
  // Sobreposição parcial (19:00–22:30 x 20:00–21:00) é checada na API (validarConflito).
  @@unique([salaId, diaSemana, horaInicio])
  @@unique([turmaId, diaSemana, horaInicio])
  @@index([cursoId])
  @@index([disciplinaId])
  @@index([professorId])
  @@map("aulas")
}
