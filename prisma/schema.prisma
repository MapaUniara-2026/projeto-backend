generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model aula {
  id_aula       Int        @id @default(autoincrement())
  id_sala       Int
  id_curso      Int
  id_disciplina Int
  id_professor  Int
  id_turma      Int
  dia_semana    String     @db.VarChar(10)
  periodo       String     @db.VarChar(12)
  hora_inicio   DateTime   @db.Time(6)
  hora_termino  DateTime   @db.Time(6)
  curso         curso      @relation(fields: [id_curso], references: [id_curso], onDelete: NoAction, onUpdate: NoAction, map: "fk_aula_curso")
  disciplina    disciplina @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction, map: "fk_aula_disciplina")
  professor     professor  @relation(fields: [id_professor], references: [id_professor], onDelete: NoAction, onUpdate: NoAction, map: "fk_aula_professor")
  sala          sala       @relation(fields: [id_sala], references: [id_sala], onDelete: NoAction, onUpdate: NoAction, map: "fk_aula_sala")
  turma         turma      @relation(fields: [id_turma], references: [id_turma], onDelete: NoAction, onUpdate: NoAction, map: "fk_aula_turma")
}

model curso {
  id_curso Int    @id @default(autoincrement())
  nome     String @db.VarChar(100)
  sigla    String @db.VarChar(10)
  aula     aula[]
}

model disciplina {
  id_disciplina Int    @id @default(autoincrement())
  nome          String @db.VarChar(100)
  aula          aula[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model imagem_local {
  id_imagem      Int     @id @default(autoincrement())
  id_local       Int
  tipo_imagem    String  @db.VarChar(12)
  caminho_imagem String  @db.VarChar(500)
  descricao      String? @db.VarChar(255)
  ordem_exibicao Int     @default(0) @db.SmallInt
  local          local   @relation(fields: [id_local], references: [id_local], onDelete: Cascade, map: "fk_imagem_local")

  @@unique([id_local, caminho_imagem], map: "uq_imagem_local")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model local {
  id_local         Int            @id @default(autoincrement())
  tipo_local       String         @db.VarChar(20)
  id_local_pai     Int?
  nome             String         @db.VarChar(100)
  codigo           String?        @unique @db.VarChar(30)
  bloco            String?        @db.VarChar(50)
  andar            Int?
  localizacao_mapa String         @db.VarChar(255)
  imagem_local     imagem_local[]
  local            local?         @relation("localTolocal", fields: [id_local_pai], references: [id_local], onUpdate: NoAction, map: "fk_local_pai")
  other_local      local[]        @relation("localTolocal")
  sala             sala?
}

model professor {
  id_professor Int    @id @default(autoincrement())
  nome         String @db.VarChar(100)
  aula         aula[]
}

model sala {
  id_sala Int    @id
  aula    aula[]
  local   local  @relation(fields: [id_sala], references: [id_local], onDelete: Cascade, onUpdate: NoAction, map: "fk_sala_local")
}

model turma {
  id_turma Int    @id @default(autoincrement())
  semestre Int
  aula     aula[]
}
